{
  "manifest_version": 1,
  "type": "device",
  "name": "Icecast",
  "description": {
    "en": "Your Icecast streams in Gladys: on air, listeners, current title, and scenes on every change.",
    "fr": "Vos flux Icecast dans Gladys : antenne, auditeurs, titre en cours et scènes à chaque changement.",
    "de": "Deine Icecast-Streams in Gladys: Sendestatus, Zuhörer, aktueller Titel, Szenen bei jeder Änderung.",
    "es": "Sus flujos Icecast en Gladys: antena, oyentes, canción actual y escenas en cada cambio."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-icecast:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-icecast/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Icecast server",
        "fr": "Votre serveur Icecast",
        "de": "Dein Icecast-Server",
        "es": "Su servidor Icecast"
      },
      "description": {
        "en": "Enter the address of your Icecast server (2.4 or newer). Its mount points on air appear in the Discover tab: add the ones you want. No password: the integration reads the public status page.",
        "fr": "Saisissez l'adresse de votre serveur Icecast (2.4 ou plus récent). Ses points de montage à l'antenne apparaissent dans l'onglet Découverte : ajoutez ceux que vous voulez. Aucun mot de passe : l'intégration lit la page de statut publique.",
        "de": "Gib die Adresse deines Icecast-Servers ein (2.4 oder neuer). Seine Mountpoints auf Sendung erscheinen im Tab „Entdecken“: Füge die gewünschten hinzu. Kein Passwort: Die Integration liest die öffentliche Statusseite.",
        "es": "Introduzca la dirección de su servidor Icecast (2.4 o posterior). Sus puntos de montaje en antena aparecen en la pestaña Descubrir: añada los que desee. Sin contraseña: la integración lee la página de estado pública."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-icecast/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://icecast.org/docs/",
          "label": {
            "en": "Icecast documentation",
            "fr": "Documentation d'Icecast",
            "de": "Icecast-Dokumentation",
            "es": "Documentación de Icecast"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Icecast address",
        "fr": "Adresse d'Icecast",
        "de": "Icecast-Adresse",
        "es": "Dirección de Icecast"
      },
      "description": {
        "en": "Address of the Icecast server, with its port (8000 by default).",
        "fr": "Adresse du serveur Icecast, avec son port (8000 par défaut).",
        "de": "Adresse des Icecast-Servers, mit seinem Port (standardmäßig 8000).",
        "es": "Dirección del servidor Icecast, con su puerto (8000 por defecto)."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2:8000",
        "fr": "ex. http://192.168.1.2:8000",
        "de": "z. B. http://192.168.1.2:8000",
        "es": "p. ej. http://192.168.1.2:8000"
      },
      "required": true
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Icecast is read: one light request for all the mount points.",
        "fr": "À quelle fréquence Icecast est lu : une requête légère pour tous les points de montage.",
        "de": "Wie oft Icecast gelesen wird: eine leichte Anfrage für alle Mountpoints.",
        "es": "Con qué frecuencia se lee Icecast: una petición ligera para todos los puntos de montaje."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when the device is added) and of the scene results.",
        "fr": "Langue des noms des fonctionnalités (fixés à l'ajout de l'appareil) et des résultats de scène.",
        "de": "Sprache der Funktionsnamen (beim Anlegen des Geräts festgelegt) und der Szenen-Ergebnisse.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir el dispositivo) y de los resultados de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "stream_started",
      "label": {
        "en": "A stream starts",
        "fr": "Un flux démarre",
        "de": "Ein Stream startet",
        "es": "Empieza un flujo"
      },
      "description": {
        "en": "A source connects to the mount point and goes on air.",
        "fr": "Une source se connecte au point de montage et prend l'antenne.",
        "de": "Eine Quelle verbindet sich mit dem Mountpoint und geht auf Sendung.",
        "es": "Una fuente se conecta al punto de montaje y sale en antena."
      },
      "fields": [
        {
          "key": "mount",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Mount point",
            "fr": "Point de montage",
            "de": "Mountpoint",
            "es": "Punto de montaje"
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "mount_name",
          "type": "string",
          "label": {
            "en": "Stream",
            "fr": "Flux",
            "de": "Stream",
            "es": "Flujo"
          }
        },
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Song",
            "fr": "Titre complet",
            "de": "Titel",
            "es": "Canción"
          }
        }
      ]
    },
    {
      "key": "stream_stopped",
      "label": {
        "en": "A stream stops",
        "fr": "Un flux s'arrête",
        "de": "Ein Stream stoppt",
        "es": "Se detiene un flujo"
      },
      "description": {
        "en": "The mount point has been off air for a minute (or Icecast silent), with the length of the stream.",
        "fr": "Le point de montage n'émet plus depuis une minute (ou Icecast ne répond plus), avec la durée du flux.",
        "de": "Der Mountpoint ist seit einer Minute nicht auf Sendung (oder Icecast stumm), mit der Dauer des Streams.",
        "es": "El punto de montaje lleva un minuto sin emitir (o Icecast no responde), con la duración del flujo."
      },
      "fields": [
        {
          "key": "mount",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Mount point",
            "fr": "Point de montage",
            "de": "Mountpoint",
            "es": "Punto de montaje"
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "mount_name",
          "type": "string",
          "label": {
            "en": "Stream",
            "fr": "Flux",
            "de": "Stream",
            "es": "Flujo"
          }
        },
        {
          "key": "duration_minutes",
          "type": "number",
          "label": {
            "en": "Duration (minutes)",
            "fr": "Durée (minutes)",
            "de": "Dauer (Minuten)",
            "es": "Duración (minutos)"
          }
        }
      ]
    },
    {
      "key": "track_changed",
      "label": {
        "en": "A new song plays",
        "fr": "Un nouveau titre passe",
        "de": "Ein neuer Titel läuft",
        "es": "Suena una nueva canción"
      },
      "description": {
        "en": "The source sends another title.",
        "fr": "La source envoie un autre titre.",
        "de": "Die Quelle sendet einen anderen Titel.",
        "es": "La fuente envía otro título."
      },
      "fields": [
        {
          "key": "mount",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Mount point",
            "fr": "Point de montage",
            "de": "Mountpoint",
            "es": "Punto de montaje"
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "mount_name",
          "type": "string",
          "label": {
            "en": "Stream",
            "fr": "Flux",
            "de": "Stream",
            "es": "Flujo"
          }
        },
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Song",
            "fr": "Titre complet",
            "de": "Titel",
            "es": "Canción"
          }
        },
        {
          "key": "artist",
          "type": "string",
          "label": {
            "en": "Artist",
            "fr": "Artiste",
            "de": "Interpret",
            "es": "Artista"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel des Songs",
            "es": "Título"
          }
        }
      ]
    },
    {
      "key": "listeners_reached",
      "label": {
        "en": "Listeners reach a threshold",
        "fr": "Les auditeurs atteignent un seuil",
        "de": "Zuhörer erreichen eine Schwelle",
        "es": "Los oyentes alcanzan un umbral"
      },
      "description": {
        "en": "The number of listeners of the mount point reaches the chosen threshold, once a day.",
        "fr": "Le nombre d'auditeurs du point de montage atteint le seuil choisi, une fois par jour.",
        "de": "Die Zuhörerzahl des Mountpoints erreicht die gewählte Schwelle, einmal pro Tag.",
        "es": "El número de oyentes del punto de montaje alcanza el umbral elegido, una vez al día."
      },
      "fields": [
        {
          "key": "mount",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Mount point",
            "fr": "Point de montage",
            "de": "Mountpoint",
            "es": "Punto de montaje"
          },
          "required": false
        },
        {
          "key": "threshold",
          "type": "select",
          "label": {
