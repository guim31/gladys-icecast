  "widgets": [
    {
      "key": "mounts",
      "label": {
        "en": "Icecast streams",
        "fr": "Flux Icecast",
        "de": "Icecast-Streams",
        "es": "Flujos Icecast"
      },
      "description": {
        "en": "The mount points on air, their listeners and the current song.",
        "fr": "Les points de montage à l'antenne, leurs auditeurs et le titre en cours.",
        "de": "Die Mountpoints auf Sendung, ihre Zuhörer und der aktuelle Titel.",
        "es": "Los puntos de montaje en antena, sus oyentes y la canción actual."
      },
      "icon": "radio",
      "settings": [
        {
          "key": "mount",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Mount point",
            "fr": "Point de montage",
            "de": "Mountpoint",
            "es": "Punto de montaje"
          },
          "required": false,
          "description": {
