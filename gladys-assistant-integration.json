  "scene_actions": [
    {
      "key": "get_now_playing",
      "label": {
        "en": "Now playing",
        "fr": "Titre en cours",
        "de": "Aktueller Titel",
        "es": "Canción actual"
      },
      "description": {
        "en": "Reads a mount point for the next actions: on air, song, listeners, and a ready-made sentence.",
        "fr": "Lit un point de montage pour les actions suivantes : antenne, titre, auditeurs, et une phrase toute prête.",
        "de": "Liest einen Mountpoint für die nächsten Aktionen: Sendestatus, Titel, Zuhörer und einen fertigen Satz.",
        "es": "Lee un punto de montaje para las siguientes acciones: antena, canción, oyentes y una frase lista."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "mount",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Mount point",
            "fr": "Point de montage",
            "de": "Mountpoint",
            "es": "Punto de montaje"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "online",
          "type": "boolean",
          "label": {
            "en": "On air",
            "fr": "À l'antenne",
            "de": "Auf Sendung",
            "es": "En antena"
          }
        },
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Song",
            "fr": "Titre complet",
            "de": "Titel",
            "es": "Canción"
          }
